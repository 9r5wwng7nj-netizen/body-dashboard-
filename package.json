{
  "name": "body-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-first training and diet tracker: workouts, nutrition and meals.",
  "type": "module",
  "scripts": {
    "start": "http-server . -p 8080 -c-1 -o /index.html",
    "build:css": "tailwindcss -i src/app.css -o assets/app.css --minify",
    "check": "node scripts/check.mjs && node --test auth/worker.test.mjs",
    "test": "npm run build:css && npm run check && playwright test",
    "test:install": "playwright install chromium",
    "test:webkit": "playwright test --config=playwright.webkit.config.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@tailwindcss/cli": "4.3.0",
    "@zxing/library": "0.23.0",
    "axe-core": "4.14.0",
    "http-server": "^14.1.1",
    "lucide": "1.55.0",
    "tailwindcss": "4.3.0"
  },
  "engines": {
    "node": ">=18"
  }
}
